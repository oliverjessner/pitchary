{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pitchary",
  "version": "0.5.1",
  "identifier": "com.pitchary.app",
  "build": {
    "beforeDevCommand": "node scripts/prepare-desktop.js",
    "frontendDist": "../public"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": [],
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "resources": {
      "runtime/": "runtime/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "13.5"
    },
    "copyright": "Copyright © Oliver Jessner",
    "shortDescription": "Local customer, sales and invoice management"
  }
}
